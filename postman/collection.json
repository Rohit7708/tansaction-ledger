{
  "info": {
    "name": "Account & Transaction Ledger API",
    "description": "Example requests for every endpoint. Run 'Create account (source)' and 'Create account (destination)' first: their test scripts store the new ids in collection variables used by the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accountId", "value": "" },
    { "key": "toAccountId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account (source)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\"\n}" },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Create account (destination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('toAccountId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Smith\"\n}" },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Create account - blank name (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"   \"\n}" },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "List accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/accounts" }
        },
        {
          "name": "Get account",
          "request": { "method": "GET", "url": "{{baseUrl}}/accounts/{{accountId}}" }
        },
        {
          "name": "Get account - malformed id (400)",
          "request": { "method": "GET", "url": "{{baseUrl}}/accounts/not-a-uuid" }
        },
        {
          "name": "Get account - not found (404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/accounts/00000000-0000-4000-8000-000000000000" }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Credit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": \"100.00\",\n  \"description\": \"Initial deposit\",\n  \"reference_id\": \"REF-001\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Debit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": \"30.00\",\n  \"description\": \"Payment\",\n  \"reference_id\": \"REF-002\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Duplicate reference (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": \"100.00\",\n  \"description\": \"Retry of REF-001\",\n  \"reference_id\": \"REF-001\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Insufficient balance (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": \"1000000.00\",\n  \"reference_id\": \"REF-TOO-MUCH\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Invalid amount (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": \"10.999\",\n  \"reference_id\": \"REF-BAD\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Transaction history (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Transaction history - invalid limit (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=500",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "500" }
              ]
            }
          }
        },
        {
          "name": "Delete transactions - not allowed (405)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{toAccountId}}\",\n  \"amount\": \"30.00\",\n  \"reference_id\": \"TRANSFER-001\",\n  \"description\": \"Transfer to another account\"\n}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "Transfer - duplicate reference (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{toAccountId}}\",\n  \"amount\": \"30.00\",\n  \"reference_id\": \"TRANSFER-001\",\n  \"description\": \"Retry\"\n}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "Transfer - same account (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{accountId}}\",\n  \"amount\": \"5.00\",\n  \"reference_id\": \"TRANSFER-SELF\"\n}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        }
      ]
    }
  ]
}
