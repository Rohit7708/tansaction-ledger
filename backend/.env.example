# Runtime environment: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by the API and Prisma migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/account_transactions?schema=public"

# Separate database used by the integration test suite (it is wiped between tests)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/account_transactions_test?schema=public"

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
